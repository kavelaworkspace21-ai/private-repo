# LegalServer.AI — environment template. Copy to .env and fill in. NEVER commit a real .env.

# ── Database ────────────────────────────────────────────────────────────────
# Local dev: SQLite. Production (on EC2, in-VPC): Aurora PostgreSQL.
DATABASE_URL=sqlite:///./legal_server.db
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@your-cluster.rds.amazonaws.com:5432/postgres?sslmode=require

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_NAME=LegalServer.AI

# ── AI answer LLM (provider-agnostic, OpenAI-compatible) ────────────────────
# Use any OpenAI-compatible endpoint. FREE option (no credit card): Groq.
#   AI_API_KEY=gsk_your_free_groq_key
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
# Other free options (verified working 2026-06-23):
#   Google Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  AI_MODEL=gemini-2.5-flash-lite
#     (note: gemini-2.0-flash / -flash-lite returned 429 no-free-quota; gemini-2.5-flash-lite worked)
#   Cerebras: AI_BASE_URL=https://api.cerebras.ai/v1  AI_MODEL=llama-3.3-70b
# NOTE: use create(stream=True) (the app does) — the OpenAI .stream() helper doesn't work with these.
# If AI_* are unset, the app falls back to OPENAI_API_KEY + the OpenAI default endpoint.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
OPENAI_API_KEY=

# ── Voice input / audio transcription (optional, Whisper-compatible) ─────────
# Enables the mic on the AI Assistant (speech → text, any Indian language). FREE option: Groq.
#   TRANSCRIBE_API_KEY=gsk_your_free_groq_key
#   TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
#   TRANSCRIBE_MODEL=whisper-large-v3
# Left blank = voice input is hidden (the Gemini answer-LLM cannot transcribe audio).
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=

# ── Embeddings ──────────────────────────────────────────────────────────────
# Default = FREE local ONNX model (no key). Only set this to use PAID OpenAI embeddings:
OPENAI_EMBEDDINGS_KEY=

# ── Field encryption at rest ────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is derived from JWT_SECRET (dev only). Set explicitly in production.
FIELD_ENCRYPTION_KEY=

# ── External legal data (optional) ──────────────────────────────────────────
# Indian Kanoon is BILLED PER CALL — the only genuinely paid dependency. Enabling it
# takes an explicit opt-in AND a key; a key alone will not spend money. Leave
# KANOON_ENABLED unset (the default) and the integration stays completely inert.
KANOON_ENABLED=false
INDIAN_KANOON_API_KEY=
# eCourts read-only official API (leave ECOURTS_API_BASE blank to keep the connector inert).
ECOURTS_API_KEY=
ECOURTS_API_BASE=

# ── Environment ─────────────────────────────────────────────────────────────
# development | test | production. UNSET IS TREATED AS PRODUCTION so that forgetting it
# fails closed: app/security_gate.py then REFUSES TO BOOT unless JWT_SECRET and
# FIELD_ENCRYPTION_KEY are strong and explicitly set. Use `development` locally.
ENVIRONMENT=development

# ── Founder / super-admin ───────────────────────────────────────────────────
# Cross-tenant admin actions (e.g. advocate verification) require this in the
# X-Admin-Token header. LEAVE BLANK to deny all such actions (fail-closed default).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Unset = password-reset emails are not delivered (the token is still generated).
# SMTP_PASS is a real credential — environment only, never committed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Ops ─────────────────────────────────────────────────────────────────────
RATELIMIT_ENABLED=1
BACKUP_DIR=backups
BACKUP_KEEP=7
LOG_LEVEL=INFO
# Error tracking. The DSN is a write-only ingest URL, but treat it as semi-sensitive:
# anyone holding it can inject events into your project. Unset = Sentry disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Restrict AI features to verified advocate/firm tenants (1 = on). Off during closed beta.
AI_REQUIRES_VERIFICATION=0

# ── Billing / Subscriptions (LSAI-V3-05 · Gate G11) ──────────────────────────
# TEST MODE ONLY until the human security/privacy review (G6/G7) passes.
# Live payments additionally require BILLING_LIVE_APPROVED=true after that sign-off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_MODE=test        # test | live   (live only after G6/G7 + BILLING_LIVE_APPROVED)
BILLING_LIVE_APPROVED=   # set to true ONLY after a human approves going live
GST_RATE_PERCENT=18      # CONFIRM the rate/treatment with a chartered accountant
COMPANY_GSTIN=
# Optional: comma-separated fallback models tried when AI_MODEL is unresponsive
AI_FALLBACK_MODELS=meta/llama-3.1-70b-instruct,meta/llama-3.1-8b-instruct

# Optional: relocate the vector store / official-PDF archive off the app drive.
# Defaults (unset) = in-repo ./chroma_db and ./data/source_pdfs — keep unset on EC2/CI.
# CHROMA_PATH=D:\Juriscite\chroma_db
# SOURCE_PDF_DIR=D:\Juriscite\source_pdfs
